# ==============================================================
# CRM ALBRA — Plantilla de variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees el archivo .env (ya está bloqueado en .gitignore).
#
# P0.4 — REGLAS DE SECRETOS:
#  1. Ningún valor marcado REPLACE_WITH_* es funcional. La aplicación SE
#     NEGARÁ A ARRANCAR en producción si conserva marcadores, valores de
#     ejemplo, secretos vacíos, cortos (<32) o de baja entropía
#     (ver src/lib/env-guard.ts + src/instrumentation.ts).
#  2. Genera cada secreto con criptografía segura:
#        openssl rand -hex 32        (o)  openssl rand -base64 48
#  3. Cada servicio debe tener su PROPIO secreto (jamás reutilizar el mismo
#     valor entre APP_SECRET / APP_ENCRYPTION_KEY / INTERNAL_API_SECRET).
#  4. Si un secreto llegó a un repo, chat o captura: RÓTALO y REVÓCALO.
#     Borrar el valor del archivo NO invalida una credencial expuesta.
# ==============================================================

# ---------- Base de datos (Prisma + SQLite) ----------
# Ruta absoluta o relativa al archivo de base de datos
DATABASE_URL="file:./db/custom.db"

# ---------- Seguridad / Autenticación ----------
# Secreto para firmar tokens JWT de sesión (mínimo 32, recomendado 64 hex)
APP_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
# Clave de cifrado simétrico para tokens de integraciones (Google, SMTP, etc.)
# DEBE ser DISTINTA de APP_SECRET
APP_ENCRYPTION_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ---------- Email (SMTP) ----------
# Usado por el motor de automatizaciones y envíos transaccionales
SMTP_HOST="smtp.tuproveedor.com"
SMTP_PORT="587"
SMTP_USER="REPLACE_WITH_SMTP_USER"
SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
SMTP_FROM_NAME="CRM ALBRA"

# ---------- WhatsApp (daemon Baileys externo) ----------
# URL del daemon de WhatsApp que corre en el servidor (puerto 3002 por defecto)
WHATSAPP_DAEMON_URL="http://localhost:3002"
# Token de verificación para webhooks entrantes de WhatsApp (mínimo 32)
WHATSAPP_VERIFY_TOKEN="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ---------- Secreto interno (daemon WhatsApp <-> CRM) ----------
# Comparte este valor con el daemon de WhatsApp (autenticación mutua).
# Debe ser DISTINTO de APP_SECRET y APP_ENCRYPTION_KEY. El daemon también
# se niega a arrancar si este valor falta, es corto o es un ejemplo conocido.
INTERNAL_API_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ---------- ALBRA AGENT CORE (Cerebro Externo: AGENTE GENERAL Python / FastAPI) ----------
# URL del microservicio cognitivo de AGENTE GENERAL (puerto 9000 por defecto)
ALBRA_AGENT_URL="http://localhost:9000"
# Token Bearer de autenticación para consultar el agente.
# P-01 (plan v1.0): SIN credencial configurada la ejecución es fail-closed.
# En producción usa un token dedicado de servicio (nunca 'albra-dev-token').
# Déjalo VACÍO si no usas el Agente General (queda deshabilitado de forma segura).
ALBRA_AGENT_API_KEY=""
# Clave de firma HMAC de requests CRM→Agente (X-Albra-Signature). Opcional:
# si se define, el Agente debe verificar timing-safe y rechazar ts > 5 min.
ALBRA_AGENT_SIGNING_KEY=""
# Activar o desactivar el puente con el Agente General (true / false)
ALBRA_AGENT_ENABLED="true"

# ---------- Opcionales ----------
# CRON_SECRET: si defines cron externo contra /api/cron/*, usa un secreto
# fuerte propio (mínimo 32). Sin definirlo, esos endpoints usan el secreto
# interno. Déjalo vacío si no usas cron externo.
# CRON_SECRET=""

# ===== REPARACIÓN INTEGRAL 2026-11-06 =====
# Puente CRM→WHATSPOWER: firma HMAC v2 (timestamp ligado al cuerpo) y Bearer
WHATSPOWER_INTERNAL_API_SECRET=
# Descargas directas: POST /api/download-ticket emite un ticket de un solo uso (60 s);
# los enlaces se construyen con ?ticket= (el JWT ya NO viaja en la URL).

# ---------- Confianza de proxies (segunda reparación §2.C) ----------
# SOLO activar si hay un proxy inverso propio (nginx/Vercel/Cloudflare) delante
# del servicio. Sin TRUST_PROXY=true, las cabeceras X-Forwarded-For / X-Real-IP
# se IGNORAN (las controla el cliente y permite saltarse límites por IP).
# TRUST_PROXY_HOPS = nº de saltos de proxy confiables (default 1): la IP válida
# es la entrada DERECHA número HOPS de X-Forwarded-For.
TRUST_PROXY="false"
TRUST_PROXY_HOPS="1"

# ===== (Auditoría A5-06) Variables adicionales usadas por el código =====
NEXT_APP_URL=                  # URL pública usada por el daemon de WhatsApp
WA_DAEMON_ENABLED=false        # true → el supervisor del daemon Baileys arranca con el server
META_APP_ID=                   # app de Meta para OAuth de conexiones (meta-oauth)
WHATSPOWER_BASE_URL=           # URL de WHATSPOWER para el plano Super Admin (/api/super/overview)
WHATSPOWER_ORG_SERVICE_CREDENTIALS=  # {"orgId":"cred"} credenciales de servicio CRM→WHATSPOWER por org
LLM_API_KEY=                   # proveedor LLM de respuestas automáticas
NVIDIA_KEY=                    # alternativa LLM (NVIDIA NIM)
TG_POLLER_INTERVAL_MS=         # intervalo del poller de Telegram
