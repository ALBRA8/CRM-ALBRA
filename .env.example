# CRM ALBRA - Variables de entorno (Plantilla de Ejemplo)
# Base de datos SQLite (ruta relativa a prisma/schema.prisma)
DATABASE_URL="file:../db/custom.db"

# Auth
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro"
NEXTAUTH_URL="http://localhost:3000"

# Secretos internos de comunicación
INTERNAL_API_SECRET="tu-secreto-interno-daemon"
INTERNAL_CHAT_SECRET="tu-secreto-chat-interno"

# Configuración SMTP (Email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="CRM ALBRA"

# Modelos de Inteligencia Artificial (LLM)
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Integración con Google (OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# App
APP_NAME="CRM ALBRA"
APP_URL="http://localhost:3000"
