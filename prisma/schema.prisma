// ============================================================
// CRM ALBRA — Prisma Schema (multi-tenant, audit-hardened)
// Every business model is scoped by organizationId (tenant isolation).
// SQLite for the preview environment; provider swap to PostgreSQL is
// a one-line change (audit recommendation #3) — no JSON columns used,
// JSON payloads stored as String fields.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & Auth ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("pilot") // pilot (única fase real; sin promesas de pago)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  clients               Client[]
  pipelineStages        PipelineStage[]
  opportunities         Opportunity[]
  reservations          Reservation[]
  quotes                Quote[]
  quoteItems            QuoteItem[]
  knowledge             Knowledge[]
  transactions          Transaction[]
  services              Service[]
  productCategories     ProductCategory[]
  automations           Automation[]
  automationRuns        AutomationRun[]
  templates             Template[]
  customFields          CustomField[]
  customFieldValues     CustomFieldValue[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  timelineEvents        TimelineEvent[]
  savedViews            SavedView[]
  agentMemories         AgentMemory[]
  agentSuggestions      AgentSuggestion[]
  agentCorrections      AgentCorrection[]
  conversationEmbeddings ConversationEmbedding[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  settings              Settings?
  nichoConfig           NichoConfig?
  integration           Integration?
  apiKeys               ApiKey[]
  agentLeadEvents       AgentLeadEvent[]
  whatsappConnections   WhatsAppConnection[]
  channelConnections    ChannelConnection[]
  channelConnectionEvents ChannelConnectionEvent[]
  channelWebhookEvents ChannelWebhookEvent[]
  channelConversations ChannelConversation[]
  workflowOutboundMessages WorkflowOutboundMessage[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  company        String?
  phone          String?
  role           String       @default("member") // owner | admin | member
  isActive       Boolean      @default(true)
  // Revocación de sesiones PERSISTENTE (segunda reparación): contador por
  // usuario embebido en cada JWT (`tv`). Cualquier punto que revoca (reset de
  // contraseña, desactivación, cambio de rol, logout global) incrementa este
  // contador de forma atómica en BD; los guardas async rechazan el token si
  // `tv` del token !== valor vigente. Es inmediato, sobrevive a reinicios y
  // funciona entre instancias porque la autoridad vive en la base de datos.
  tokenVersion   Int          @default(0)
  avatar         String?
  leadCount      Int          @default(0)    // Fase 2: contador para round-robin de leads
  lastLeadAt     DateTime?                   // Fase 2: último lead asignado (desempate del round-robin)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedViews     SavedView[]
  apiKeysCreated ApiKey[]
  // B3: guarda sha256(token) — el token en claro SOLO viaja por email; nunca en BD.
  resetToken     String?
  resetTokenExp  DateTime?
  // OLEADA 2 — 2FA TOTP (RFC 6238):
  //  - twoFactorSecret: secreto base32 CIFRADO con AES-256-GCM (src/lib/crypto.ts,
  //    clave APP_ENCRYPTION_KEY/APP_SECRET). El secreto en claro SOLO se muestra
  //    una vez en el enrolamiento (POST /api/auth/2fa/setup).
  //  - twoFactorEnabled: el login exige el segundo factor SOLO cuando está en true
  //    (el secreto puede existir en false mientras el usuario confirma el enrolamiento).
  //  - twoFactorRecovery: JSON array de hashes SHA-256 de los códigos de
  //    recuperación (un solo uso cada uno). Los códigos en claro se muestran UNA vez.
  //  - twoFactorLastCounter: último contador TOTP consumido (replay: un código
  //    usado en un ventana de 30s no vuelve a servir).
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorRecovery    String?
  twoFactorLastCounter Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ---------- Claves de API (host/contratos: servidor MCP y acciones CRM) ----------
// La clave cruda (`albra_<48 hex>`) se muestra UNA vez al crearla; en BD solo
// vive su hash SHA-256 (@unique → lookup O(1)). Revocación inmediata.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  hashedKey      String    @unique
  prefix         String
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ---------- CRM Core ----------

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  cedula         String?
  address        String?
  notes          String?
  status         String       @default("prospect") // prospect | active | inactive
  source         String? // landing | whatsapp | referral | manual | instagram | telegram
  lastContactAt  DateTime?
  assignedToId   String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  histories             ClientHistory[]
  preferences           ClientPreferences?
  opportunities         Opportunity[]
  reservations          Reservation[]
  quotes                Quote[]
  transactions          Transaction[]
  memories              AgentMemory[]
  suggestions           AgentSuggestion[]
  agentCorrections      AgentCorrection[]
  conversationEmbeddings ConversationEmbedding[]
  whatsappConversations WhatsAppConversation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastContactAt])
}

model ClientHistory {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String // call | note | email | meeting | whatsapp | system
  title          String
  description    String?
  userId         String?
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientPreferences {
  id               String  @id @default(cuid())
  organizationId   String
  clientId         String  @unique
  client           Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preferredChannel String? // whatsapp | email | phone | instagram | telegram
  preferredTime    String?
  interests        String? // JSON array
  notes            String?
}

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  color          String       @default("#059669")
  probability    Float        @default(0.5)
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)

  opportunities Opportunity[]

  @@index([organizationId, order])
}

model Opportunity {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  stageId           String?
  stage             PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  amount            Float          @default(0)
  currency          String         @default("USD")
  probability       Float?
  expectedCloseDate DateTime?
  status            String         @default("open") // open | won | lost
  closedAt          DateTime?
  notes             String?
  source            String?
  assignedToId      String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  quotes Quote[]

  @@index([organizationId, status])
  @@index([organizationId, clientId])
  // (auditoría 2026-11-11) Tablero de pipeline: filtros por organización + etapa.
  @@index([organizationId, stageId])
}

model Reservation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  status         String       @default("scheduled") // scheduled | completed | cancelled
  location       String?
  userId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, startsAt])
}

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  legacyItems    String? // (deprecado) JSON pre-migración a tabla QuoteItem
  items          QuoteItem[]
  subtotal       Float        @default(0)
  tax            Float        @default(0)
  total          Float        @default(0)
  currency       String       @default("USD")
  status         String       @default("draft") // draft | sent | accepted | rejected | expired
  validUntil     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  // Unicidad del número de cotización POR ORGANIZACIÓN (segunda reparación):
  // dos organizaciones pueden usar el mismo número, pero dentro de una org el
  // número es único a nivel BD (defensa en profundidad frente a carreras).
  @@unique([organizationId, number])
  // (A4-08) índice para consultas de cotizaciones por oportunidad
  @@index([opportunityId])
}

// Cubos de rate limiting PERSISTENTES (segunda reparación): los límites de los
// endpoints sensibles (login/reset/forgot) se cuentan en BD, no en memoria,
// para que sean efectivos entre reinicios y entre instancias que compartan la
// misma base de datos. Limpieza perezosa de cubos vencidos en cada escritura.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Contadores atómicos por organización (segunda reparación §2.E): asignación
// del número de cotización con un único upsert-increment (sin transacción
// interactiva en el camino caliente — bajo SQLite la contención de varias
// transacciones interactivas paralelas es patológica; un statement atómico no).
model OrgCounter {
  key   String @id
  value Int    @default(0)
}

// Líneas de detalle de una cotización (portado del repo base, ahora relacional)
model QuoteItem {
  id             String        @id @default(cuid())
  quoteId        String
  quote          Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sku            String?
  description    String
  quantity       Int           @default(1)
  unitPrice      Float         @default(0)
  subtotal       Float         @default(0)
  position       Int           @default(0)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([quoteId])
}

model Transaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // income | expense
  category       String?
  description    String?
  amount         Float
  currency       String       @default("USD")
  date           DateTime     @default(now())
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quoteId        String?
  method         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
}

// ---------- Catálogo ----------

model Service {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       String?
  price          Float        @default(0)
  duration       Int?
  unit           String       @default("unidad")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model ProductCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
}

// ---------- Automatizaciones / Workflows (inspirado en Twenty) ----------

model Automation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String       @default("custom") // seguimiento | confirmacion | promocion | custom
  description    String?
  // Motor de workflows: trigger -> [conditions] -> actions[]
  triggerType    String       @default("manual") // manual | client_created | opportunity_stage_changed | message_received | reservation_created | quote_status_changed | schedule
  triggerConfig  String? // JSON: { stageId?, schedule?, channel? }
  conditions     String? // JSON array: [{ field, operator, value }]
  actions        String? // JSON array: [{ type, config }]
  isActive       Boolean      @default(false)
  runCount       Int          @default(0)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs AutomationRun[]

  @@index([organizationId, isActive])
}

model AutomationRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationId   String
  automation     Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status         String       @default("running") // running | success | failed | waiting
  input          String? // JSON: payload del trigger (contexto para reanudar)
  output         String? // JSON: outputs acumulados de las acciones ejecutadas
  error          String?
  stepStates     String? // JSON: [{ type, status, error?, ms? }] estado por acción (estilo Twenty stepInfos)
  currentStep    Int          @default(0) // índice de la siguiente acción al reanudar (DELAY estilo Twenty)
  resumeAt       DateTime? // cuándo reanudar un run en espera (acción "Esperar")
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  idempotencyKey String? // trigger:entidad — evita doble ejecución por retry/webhook duplicado
  stepLedgerVersion Int           @default(0) // 1 = write-ahead ledger habilitado; 0 = run histórico
  // Lease durable y fencing monotónico: cada reclamación incrementa la versión.
  leaseToken       String?
  leaseExpiresAt   DateTime?
  fencingVersion  Int           @default(0)
  stepExecutions  WorkflowStepExecution[]

  @@index([automationId, startedAt])
  @@index([status, resumeAt])
  @@index([status, leaseExpiresAt])
  @@unique([automationId, idempotencyKey])
}

// ---------- IA ----------

model AgentMemory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key            String?
  content        String
  source         String       @default("manual") // manual | agent | conversation | correction
  type           String       @default("fact") // fact | preference | observation | learning | procedural (contrato MemoryDV)
  importance     Int          @default(1)
  embedding      String? // JSON array de floats (vector del content); null → solo texto
  createdAt      DateTime     @default(now())

  @@index([organizationId, clientId])
}

// Memoria vectorial de conversaciones (Fase 5): fragmentos de mensajes entrantes
// y salientes con su embedding para recall semántico por cliente. El embedding
// es opcional: sin proveedor de embeddings la memoria sigue funcionando por
// recencia (degradación elegante, nunca bloquea el camino del mensaje).
model ConversationEmbedding {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel        String       @default("whatsapp") // whatsapp | telegram | instagram | chat | sistema
  role           String       @default("incoming") // incoming | outgoing
  text           String
  embedding      String? // JSON array de floats (2048 dims en nemotron-3-embed-1b)
  consolidated   Boolean      @default(false) // ya resumido en hechos por la consolidación
  createdAt      DateTime     @default(now())

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, consolidated])
}

// Auto-mejora del agente (patrón self-improving): cuando el vendedor edita un
// mensaje sugerido por la IA antes de enviarlo, se guarda el par original→final
// como lección de estilo. Se inyecta como few-shot en prompts futuros.
model AgentCorrection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  original       String
  final          String
  channel        String? // whatsapp | email | instagram | telegram
  embedding      String? // JSON del vector del original (para recall semántico)
  createdAt      DateTime     @default(now())

  @@index([organizationId, clientId])
}

model AgentSuggestion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String // follow_up | reengage | opportunity | at_risk
  title          String
  description    String?
  priority       String       @default("medium") // high | medium | low
  status         String       @default("new") // new | accepted | dismissed
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
}

// ---------- Comunicación / Plantillas ----------

model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String       @default("seguimiento") // seguimiento | confirmacion | promocion
  channel        String       @default("generic") // whatsapp | telegram | instagram | email | generic
  subject        String?
  body           String // soporta {{variables}}
  variables      String? // JSON array de nombres de variables
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, channel])
}

// ---------- Campos personalizados ----------

model CustomField {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String // client | opportunity | quote | reservation
  name           String
  label          String
  type           String       @default("text") // text | number | date | select | multiselect | boolean | url | phone
  options        String? // JSON array para select
  isRequired     Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  values CustomFieldValue[]

  @@index([organizationId, entity])
}

model CustomFieldValue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldId        String
  field          CustomField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  value          String?

  @@unique([fieldId, entityId])
  @@index([entityType, entityId])
}

// ---------- Notificaciones / Actividad / Timeline ----------

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  type           String       @default("system") // system | automation | agent | integration
  title          String
  body           String?
  data           String? // JSON
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, isRead])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  action         String // created | updated | deleted | login | exported | ran_automation ...
  entity         String // client | opportunity | quote | ...
  entityId       String?
  details        String? // JSON
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model TimelineEvent {
  sourceEventKey String? // Stable provider event key for retry-safe timeline writes
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  opportunityId  String?
  quoteId        String?
  reservationId  String?
  type           String // note | call | meeting | whatsapp | telegram | instagram | email | quote | stage_change | system | transaction
  title          String
  description    String?
  metadata       String? // JSON
  source         String       @default("manual") // manual | agent | integration | automation
  userId         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, opportunityId, createdAt])
  @@unique([organizationId, sourceEventKey])
}

// ---------- Vistas guardadas (inspirado en Twenty) ----------

model SavedView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  entity         String // clients | opportunities | quotes
  filters        String? // JSON array: [{ field, operator, value }]
  sort           String? // JSON: { field, direction }
  isShared       Boolean      @default(false)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, entity])
}

// ---------- Configuración por organización ----------

model Settings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency           String       @default("USD")
  timezone           String       @default("America/Bogota")
  autoAssignLeads    Boolean      @default(true) // Fase 2: round-robin automático de leads entrantes
  dealAiEnabled      Boolean      @default(true) // Fase 4: IA de cierre (sugerencias en pipeline)
  llmProvider        String? // openai | groq | custom | zai
  llmBaseUrl         String?
  llmModel           String?
  llmApiKeyEnc       String? // AES-256-GCM cifrado en reposo (recomendación auditoría #4)
  llmEmbedModel      String? // modelo de embeddings del proveedor (ej. nvidia/nemotron-3-embed-1b); null → memoria sin vectores (fallback recencia)
  vapidPublicKey     String?
  vapidPrivateKeyEnc String?
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassEnc        String?
  smtpFrom           String?
  updatedAt          DateTime     @updatedAt
}

model NichoConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandingName     String       @default("CRM ALBRA")
  rubro            String       @default("Servicios Profesionales")
  personality      String       @default("Profesional, empático y orientado a resultados")
  tone             String?
  services         String? // JSON array
  faqs             String? // JSON array
  workingHours     String?
  autoReplyEnabled Boolean      @default(true)
  handoffKeywords  String? // JSON array — palabras que transfieren a humano
  raw              String? // JSON libre
  updatedAt        DateTime     @updatedAt
}

model Integration {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Tokens SIEMPRE cifrados con AES-256-GCM antes de guardar (auditoría #4)
  telegramBotTokenEnc   String?
  telegramSecret        String?
  // (A2-23, auditoría 2026-11-11) Lookup por HASH del secret (el valor queda
  // cifrado en reposo con AES-256-GCM); la comparación final es timing-safe.
  telegramSecretHash    String?  @unique
  instagramTokenEnc     String?
  instagramAccountId    String?
  googleRefreshTokenEnc String?
  googleClientJsonEnc   String?
  googleEmail           String?   // cuenta conectada vía OAuth ("Conectar con Google")
  metaAppSecretEnc      String?
  whatsappPhoneId       String?
  whatsappCloudTokenEnc String?
  agentLeadsSecretEnc   String?      // Secret HMAC-SHA256 del webhook AGENTE-LEADS (cifrado AES-256-GCM)
  // Facebook (Messenger de la Página). Token de página como blob cifrado:
  // { pageToken, webhookVerifyToken }. El App Secret de Meta vive en metaAppSecretEnc
  // (compartido con Instagram: misma app de Meta).
  facebookTokenEnc      String?
  facebookPageId        String?
  // Metadatos del OAuth "Conectar mediante Meta" (página elegida + cuenta que autorizó)
  facebookPageName      String?
  facebookUserEmail     String?
  // TikTok. Blob cifrado: { accessToken, refreshToken?, openId?, displayName?,
  // appKey?, appSecret?, webhookVerifyToken?, extraScopes?, sendEndpoint? }.
  // Los DMs por API exigen acceso Business Messaging (programa de socios de TikTok):
  // el canal queda cableado y se activa cuando TikTok apruebe la app.
  tiktokTokenEnc        String?
  enableWhatsApp        Boolean      @default(false)
  enableTelegram        Boolean      @default(false)
  enableInstagram       Boolean      @default(false)
  enableFacebook        Boolean      @default(false)
  enableTikTok          Boolean      @default(false)
  enableGoogle          Boolean      @default(false)
  updatedAt             DateTime     @updatedAt
}

// ---------- Conexiones WhatsApp por organización (OLEADA 2 — arquitectura SaaS) ----------
// Decisión de negocio (2026-11-11): cada organización conecta SUS propios
// números de WhatsApp con SUS credenciales de Meta (flujo oficial Embedded
// Signup / OAuth — jamás contraseñas). Una organización puede tener UNO o
// VARIOS números según su plan (whatsapp-plans.ts); cada conexión vive
// exclusivamente bajo su organizationId y su token se almacena SIEMPRE
// cifrado (AES-256-GCM, src/lib/crypto.ts). La revocación/desconexión de una
// conexión no afecta a las demás organizaciones ni a las demás conexiones.
//
// Compatibilidad: Integration.whatsappCloudTokenEnc (un número por org)
// sigue funcionando como legado; el webhook resuelve primero por
// WhatsAppConnection y cae al legado solo si no hay conexión nueva.
model WhatsAppConnection {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Identidad de la cuenta de negocio de Meta:
  wabaId         String?  // WhatsApp Business Account (WABA)
  phoneNumberId  String   @unique // identificador técnico del número en Graph API
  phoneNumber    String   // número E.164 (solo lectura informativa, NUNCA clave de ruta)
  displayName    String?  // nombre comercial mostrado en WhatsApp
  // Credencial: token de acceso de la conexión — cifrado en reposo. En claro
  // SOLO existe en memoria durante un envío/verificación (nunca en BD, logs ni
  // respuestas de API; las rutas lo enmascaran con maskSecret).
  accessTokenEnc String
  // Secreto de la app Meta dueña de la conexión: si la org conectó vía
  // Embedded Signup de NUESTRA app, es el global (META_APP_SECRET env) y este
  // campo queda null; si la org usa su propia app Meta, su secreto va cifrado aquí.
  metaAppSecretEnc String?
  // verify_token por conexión para la verificación GET del webhook de Meta
  webhookVerifyToken String
  // Ciclo de vida: pending | connected | disconnected | revoked | error
  status         String   @default("pending")
  statusDetail   String?  // motivo legible del último cambio de estado
  source         String   @default("embedded_signup") // embedded_signup | manual
  tokenExpiresAt DateTime? // si el token es de vida corta (sistema token de Embedded Signup)
  lastVerifiedAt DateTime?
  lastErrorAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         WhatsAppConnectionEvent[]

  @@index([organizationId, status])
}

// Auditoría del ciclo de vida de cada conexión (decisión #8/#9: trazabilidad
// de connect/disconnect/revoke por organización, sin exponer secretos).
// connectionId es OPCIONAL: también registra eventos de organización sin
// conexión (ej. intento bloqueado por límite de plan).
model WhatsAppConnectionEvent {
  id             String              @id @default(cuid())
  connectionId   String?
  connection     WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organizationId String
  type           String // connected | disconnected | revoked | token_rotated | verified | error | plan_limit_blocked
  detail         String?
  createdAt      DateTime           @default(now())

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
}

// ---------- Conexiones canónicas multicuenta de canales ----------
// Fase 0: modelo aditivo. Las tablas legacy (Integration y WhatsAppConnection)
// permanecen intactas hasta completar backfill, dual-read y pruebas de paridad.
model ChannelConnection {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel           String   // whatsapp | instagram | facebook | telegram | tiktok
  provider          String   // adaptador/proveedor concreto; no inferirlo del canal
  providerAccountKey String  @unique // clave externa namespaced, normalizada y no secreta
  externalAccountId String   // ID de cuenta/página/número/bot en el proveedor
  displayName       String?
  status            String   @default("pending") // pending | connected | reconnect_required | disconnected | revoked | error
  scopes            String?  // JSON serializado; nunca contiene credenciales
  credentialsEnc    String   // blob cifrado AES-256-GCM; nunca exponer por API/logs
  metadata          String?  // JSON allowlisted no secreto
  tokenExpiresAt    DateTime?
  lastVerifiedAt    DateTime?
  lastErrorAt       DateTime?
  lastErrorCode     String?  // código sanitizado; nunca guardar respuesta/token del proveedor
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events            ChannelConnectionEvent[]
  webhookEvents     ChannelWebhookEvent[]
  conversations     ChannelConversation[]

  @@index([organizationId, channel, status])
  @@index([organizationId, createdAt])
  @@index([provider, externalAccountId])
  @@unique([id, organizationId])
}

model ChannelConnectionEvent {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  type           String   // connected | disconnected | revoked | token_rotated | verified | error
  detail         String?  // detalle sanitizado, sin tokens ni PII innecesaria
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
}



 // Registro durable de recepción por conexión. No almacena payloads ni secretos.
model ChannelWebhookEvent {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     ChannelConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  eventKey       String
  eventType      String
  status         String   @default("processing") // processing | processed | failed
  claimToken     String?  // fencing token del propietario vigente del lease
  attemptCount   Int      @default(1)
  lastErrorCode  String?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([connectionId, eventKey])
  @@index([organizationId, receivedAt])
  @@index([status, updatedAt])
}

// Conversación canónica aislada por conexión. Se introduce en paralelo a
// WhatsAppConversation para permitir migración expand/contract sin reasignar
// históricos ambiguos ni cambiar de golpe las consultas legacy.
model ChannelConversation {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId        String
  connection          ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  channel             String
  externalContactKey  String
  contactName         String?
  lastMessage         String?
  lastMessageAt       DateTime?
  unreadCount         Int      @default(0)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  messages            ChannelMessage[]
  outboundMessages     ChannelOutboundMessage[]

  @@unique([connectionId, externalContactKey])
  @@index([organizationId, channel, lastMessageAt])
  @@index([connectionId, lastMessageAt])
}


// Mensajes canónicos: conservan el hilo y la cuenta exacta del proveedor.
// Se añaden en paralelo a WhatsAppMessage/TimelineEvent durante expand.
model ChannelMessage {
  id                String   @id @default(cuid())
  conversationId    String
  conversation      ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalMessageId String?
  direction         String   // in | out
  senderType        String   // contact | agent | user
  body              String
  messageType       String   @default("text")
  metadata          String?  // JSON no secreto, allowlisted
  outboundId        String?  @unique
  outbound          ChannelOutboundMessage? @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
}


 
// Intención/outbox de mensajes salientes. Un intento incierto NUNCA se reenvía
// automáticamente: sin idempotencia garantizada por el proveedor podría duplicar.
model ChannelOutboundMessage {
  id                String   @id @default(cuid())
  conversationId    String
  conversation      ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientRequestId   String
  body              String
  status            String   @default("queued") // queued | sending | sent | failed | unknown
  attemptCount      Int      @default(0)
  requestedByUserId String?
  providerMessageId String?
  providerErrorCode String?  // código sanitizado, nunca cuerpo/token de respuesta
  startedAt         DateTime?
  sentAt            DateTime?
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  message           ChannelMessage?

  @@unique([conversationId, clientRequestId])
  @@index([status, createdAt])
  @@index([conversationId, createdAt])
}

// ---------- AGENTE-LEADS (webhook de eventos de prospección) ----------
// Receptor oficial de los eventos emitidos por AGENTE-LEADS (contrato §26):
// lead.created / lead.scored / lead.intelligenced / lead.outreach_sent /
// execution.completed. Registro de trazabilidad + dedup por event_id +
// auditoría de rechazos. Secret de verificación HMAC por organización
// (Integration.agentLeadsSecretEnc): la organización queda determinada por
// el secret que matchea la firma — misma barrera multi-tenant del webhook
// de WhatsApp (sin trust en el body).
model AgentLeadEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String?      // event_id §26 del emisor (evt_…)
  type           String       // lead.created | lead.scored | lead.intelligenced | lead.outreach_sent | execution.completed
  leadId         String?      // lead_id del emisor
  executionId    String?
  payload        String?      // JSON del evento (trazabilidad completa)
  status         String       @default("processed") // processed | deduped | error
  error          String?
  clientId       String?
  opportunityId  String?
  receivedAt     DateTime     @default(now())

  @@unique([organizationId, eventId])
  @@index([organizationId, receivedAt])
  @@index([organizationId, leadId])
}

// ============ WhatsApp (daemon Baileys, puerto 3002) ============
// Conversaciones/mensajes reales gestionados por src/whatsapp-daemon/daemon.mjs.
// Multi-tenant: cada conversación pertenece a la organización del número conectado.

model WhatsAppConversation {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactPhone    String
  contactName     String?
  lastMessage     String?
  lastMessageAt   DateTime?
  lastMessageFrom String?
  unreadCount     Int               @default(0)
  isAutoReply     Boolean           @default(true)
  status          String            @default("active") // active | closed
  transferredTo   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        WhatsAppMessage[]

  @@unique([organizationId, contactPhone])
  @@index([organizationId, lastMessageAt])
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?
  direction      String // inbound | outbound
  fromNumber     String
  toNumber       String
  text           String?
  messageType    String               @default("text")
  senderType     String // contact | agent | user
  isRead         Boolean              @default(false)
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
}

// ---------- Base de conocimiento del Agente IA ----------

model Knowledge {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String
  category       String       @default("general") // general | catalogo | terminos | faq | politicas
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
}


// Outbox durable para acciones externas originadas en workflows.
// El payload se cifra porque contiene destinatarios y contenido del mensaje.
model WorkflowOutboundMessage {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationId      String?
  automationRunId   String?
  stepIndex         Int
  idempotencyKey    String
  channel           String   // whatsapp | telegram | email
  payloadEnc        String
  status            String   @default("queued") // queued | sending | sent | failed | unknown
  attemptCount      Int      @default(0)
  claimToken        String?
  providerMessageId String?
  providerErrorCode String?
  startedAt         DateTime?
  sentAt            DateTime?
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@index([automationRunId, stepIndex])
}


// Registro write-ahead de cada acción de workflow. Un paso en started tras un
// crash es ambiguo y nunca se reejecuta automáticamente.
model WorkflowStepExecution {
  id               String        @id @default(cuid())
  automationRunId  String
  automationRun    AutomationRun @relation(fields: [automationRunId], references: [id], onDelete: Cascade)
  stepIndex        Int
  actionType       String
  status           String        @default("started") // started | succeeded | failed | unknown
  output           String?
  error            String?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?

  @@unique([automationRunId, stepIndex])
  @@index([status, startedAt])
}
